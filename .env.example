# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assessment_platform

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI (extraction, question generation, matching, candidate analysis) --
# "mock" (default) needs no key and runs out of the box. Switch to
# "anthropic" once AI_API_KEY is set.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Speech-to-text (Communication session) -------------------------------
# "mock" (default) returns an empty transcript rather than a fake one — see
# backend/src/speech/providers/mockSpeechProvider.ts. Switch to "openai"
# once SPEECH_API_KEY is set (a separate vendor/key from AI_API_KEY above —
# Anthropic doesn't offer speech-to-text).
SPEECH_PROVIDER=mock
SPEECH_API_KEY=

# --- Storage (wired up in a later phase — local disk is used regardless) --
STORAGE_API_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# --- Bootstrap (used once by `npm run seed`, not read by the running server) --
# Creates the first SUPER_ADMIN account — see backend/src/scripts/seed.ts.
# Defaults to admin@example.com / ChangeMe123! if left unset (dev only).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
